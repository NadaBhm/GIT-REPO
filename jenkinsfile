pipeline {
    agent any
    tools {
        jdk 'JDK21'
    }

    stages {
        stage('Checkout Code') {
            steps {
                git branch : 'main' , url: "https://github.com/NadaBhm/GIT-REPO.git"
            }
        }
    stage('Compile Code')
    {
        steps {
            sh 'javac Test.java'
        }
    }
    stage('Executer Code')
    {
        steps{
            sh 'java Test'
        }
    }
    }
}
